# PostgreSQL / Patroni credentials
# Эти переменные подхватываются Patroni автоматически через environment в docker-compose.yml
# Пароли храним только здесь — patroni*.yml их не содержит
PATRONI_SUPERUSER_USERNAME=postgres
PATRONI_SUPERUSER_PASSWORD=SuperSecret123
PATRONI_REPLICATION_USERNAME=replicator
PATRONI_REPLICATION_PASSWORD=ReplSecret123
PATRONI_REWIND_USERNAME=postgres
PATRONI_REWIND_PASSWORD=SuperSecret123

# Сеть
SUBNET=172.20.0.0/24
ETCD1_IP=172.20.0.21
ETCD2_IP=172.20.0.22
ETCD3_IP=172.20.0.23
PG1_IP=172.20.0.11
PG2_IP=172.20.0.12
PG3_IP=172.20.0.13
HAPROXY1_IP=172.20.0.31
HAPROXY2_IP=172.20.0.32

# Cluster name
CLUSTER_NAME=pg_cluster
